---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import { asset } from '../lib/assets';
import { type Locale, withBase } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title?: string;
}

const { locale, title = 'Luminosa Film' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang={locale} class="scheme-dark">
	<head>
		<!-- Start cookieyes banner -->
		<script
			is:inline
			id="cookieyes"
			type="text/javascript"
			src="https://cdn-cookieyes.com/client_data/c7d00edda381951a6449bb93a4f30ced/script.js"
		></script>
		<!-- End cookieyes banner -->
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={asset('/global/favicon.png')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL.href} />
		<title>{title}</title>
		<link rel="stylesheet" href={withBase('/fonts/fonts.css')} />
	</head>
	<body class="flex min-h-screen flex-col bg-woodsmoke font-sans text-woodsmoke-50">
		<Navigation locale={locale} />
		<div class="flex-1">
			<slot />
		</div>
		<Footer locale={locale} />
		<script>
			import { initScrollStaggers } from '../scripts/scroll-stagger';

			initScrollStaggers();
		</script>
	</body>
</html>
