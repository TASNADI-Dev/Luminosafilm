---
import { PortableText as PortableTextRenderer } from 'astro-portabletext';
import type { PortableTextBlock } from '@portabletext/types';

interface Props {
	value: PortableTextBlock[];
}

const { value } = Astro.props;
---

<div
	class="[&_a]:text-azure-300 [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors hover:[&_a]:text-azure-200 [&_blockquote]:my-6 [&_blockquote]:border-l [&_blockquote]:border-woodsmoke-700 [&_blockquote]:pl-4 [&_blockquote]:italic [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:font-heading [&_h2]:text-[1.5rem] [&_h2]:leading-snug [&_h2]:tracking-tight [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-heading [&_h3]:text-[1.25rem] [&_h3]:leading-snug [&_li]:mb-2 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:text-[1.125rem] [&_ol]:leading-relaxed [&_p]:mb-6 [&_p]:text-[1.125rem] [&_p]:leading-relaxed [&_p]:text-woodsmoke-50 [&_p:last-child]:mb-0 [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:text-[1.125rem] [&_ul]:leading-relaxed"
>
	<PortableTextRenderer value={value} />
</div>
