---
import { asset } from '../lib/assets';
import {
	type Locale,
	designerHref,
	footerUi,
	localeHomePath,
	navItems,
	navUi,
	pagePath,
} from '../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'hu' } = Astro.props;
const items = navItems[locale];
const ui = navUi[locale];
const copy = footerUi[locale];
const serviceLinks = items.find((item) => item.children?.length)?.children ?? [];
const pageLinks = items.filter((item) => !item.children?.length);
const year = new Date().getFullYear();
const copyright = copy.copyright.replace('{year}', String(year));
const privacyHref = pagePath(locale, 'privacy');
const tasnadiHref = designerHref[locale];

const linkClass =
	'cursor-pointer font-sans text-[0.875rem] font-medium tracking-wide text-woodsmoke transition-colors hover:text-azure';
const metaClass =
	'font-sans text-[0.75rem] font-medium tracking-wide text-woodsmoke-600';
const metaLinkClass =
	'cursor-pointer font-sans text-[0.75rem] font-medium tracking-wide text-woodsmoke-600 underline underline-offset-2 transition-colors hover:text-azure';
---

<footer class="border-t border-woodsmoke-200 bg-woodsmoke-50 text-woodsmoke">
	<div
		class="mx-auto flex max-w-container flex-col gap-8 px-6 py-8 lg:flex-row lg:justify-between lg:px-10"
	>
		<div class="flex flex-col gap-8">
			<a href={localeHomePath(locale)} class="shrink-0" aria-label={ui.homeAria}>
				<img
					src={asset('/global/logo.svg')}
					alt="Luminosa Film"
					width="59"
					height="56"
					class="h-14 w-auto"
				/>
			</a>
			<div class="mt-auto flex flex-col gap-2">
				<a
					href="https://www.youtube.com/@luminosafilm5112"
					class="inline-flex items-center gap-2 text-woodsmoke transition-colors hover:text-azure"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg class="size-8 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
						></path>
					</svg>
					<span class={metaClass}>{copy.youtubeLabel}</span>
				</a>
				<a
					href="https://www.facebook.com/luminosafilm/"
					class="inline-flex items-center gap-2 text-woodsmoke transition-colors hover:text-azure"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg class="size-8 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
						></path>
					</svg>
					<span class={metaClass}>{copy.facebookLabel}</span>
				</a>
			</div>
		</div>

		<nav aria-label={copy.navLabel}>
			<div class="flex gap-10 lg:gap-16">
				<ul class="flex list-none flex-col gap-2 p-0">
					{
						serviceLinks.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
				<ul class="flex list-none flex-col gap-2 p-0">
					{
						pageLinks.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>
	</div>

	<div class="border-t border-woodsmoke-200">
		<div
			class="mx-auto flex max-w-container flex-col gap-3 px-6 py-4 lg:flex-row lg:items-center lg:justify-between lg:px-10"
		>
			<p class={metaClass}>{copyright}</p>
			<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
				<a href={privacyHref} class={metaLinkClass}>{copy.privacy}</a>
				<button type="button" class:list={[metaLinkClass, 'cky-banner-element border-0 bg-transparent p-0']}>
					{copy.cookieSettings}
				</button>
				<p class={metaClass}>
					{copy.designBy}{' '}
					<a href={tasnadiHref} class={metaLinkClass} target="_blank" rel="noopener noreferrer">
						{copy.designName}
					</a>
				</p>
			</div>
		</div>
	</div>
</footer>
