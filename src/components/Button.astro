---
interface Props {
	href?: string;
	type?: 'button' | 'submit';
	variant?: 'primary' | 'secondary';
	target?: '_blank' | '_self';
	class?: string;
}

const {
	href,
	type = 'button',
	variant = 'primary',
	target,
	class: className,
} = Astro.props;
const Tag = href ? 'a' : 'button';

const innerVariants = {
	primary: 'bg-gradient-to-b from-bunting-700 to-bunting-950',
	secondary: 'bg-woodsmoke-950',
} as const;
---

<span
	class:list={[
		'inline-flex cursor-pointer rounded-full bg-gradient-to-br from-bunting-950 to-bunting-500 p-px transition-[filter] duration-200 hover:brightness-110',
		className,
	]}
>
	<Tag
		href={href}
		type={href ? undefined : type}
		target={href ? target : undefined}
		rel={href && target === '_blank' ? 'noopener noreferrer' : undefined}
		class:list={[
			'inline-flex cursor-pointer items-center justify-center rounded-full px-[1.5rem] py-[0.75rem] font-sans text-[0.9375rem] font-medium text-woodsmoke-50',
			innerVariants[variant],
		]}
	>
		<slot />
	</Tag>
</span>
