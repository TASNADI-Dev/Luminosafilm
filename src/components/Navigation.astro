---
import { asset } from '../lib/assets';
import {
	type Locale,
	localeHomePath,
	navItems,
	navUi,
	switchLocalePath,
} from '../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'hu' } = Astro.props;
const items = navItems[locale];
const ui = navUi[locale];
const pathname = Astro.url.pathname;
const huHref = switchLocalePath(pathname, 'hu');
const enHref = switchLocalePath(pathname, 'en');
const navLabel = locale === 'hu' ? 'Főnavigáció' : 'Main navigation';
const langLabel = locale === 'hu' ? 'Nyelvválasztó' : 'Language switcher';

const linkClass =
	'cursor-pointer font-sans text-[0.9375rem] font-medium tracking-wide text-woodsmoke-50 transition-colors hover:text-azure-300';
const dropdownLinkClass =
	'block cursor-pointer px-4 py-2.5 font-sans text-[0.875rem] font-medium tracking-wide text-woodsmoke-50 transition-colors hover:bg-woodsmoke-900 hover:text-azure-300';
---

<header class="sticky top-0 z-50 bg-woodsmoke text-woodsmoke-50" data-navigation>
	<nav
		class="mx-auto flex h-[5rem] max-w-container items-center justify-between gap-6 px-6 lg:px-10"
		aria-label={navLabel}
	>
		<a href={localeHomePath(locale)} class="shrink-0" aria-label={ui.homeAria}>
			<img
				src={asset('/global/logo.svg')}
				alt="Luminosa Film"
				width="59"
				height="56"
				class="h-14 w-auto"
			/>
		</a>

		<div class="flex items-center gap-6 lg:gap-10">
			<ul class="hidden items-center gap-8 lg:flex">
				{
					items.map((item) =>
						item.children?.length ? (
							<li class="relative" data-nav-dropdown>
								<button
									type="button"
									class:list={[linkClass, 'inline-flex items-center gap-1.5']}
									data-nav-dropdown-toggle
									aria-expanded="false"
									aria-haspopup="true"
									aria-controls={`nav-dropdown-${item.href.slice(1)}`}
								>
									{item.label}
									<svg
										class="h-3.5 w-3.5 transition-transform duration-200"
										data-nav-dropdown-chevron
										viewBox="0 0 16 16"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d="M4 6l4 4 4-4" />
									</svg>
								</button>
								<ul
									id={`nav-dropdown-${item.href.slice(1)}`}
									class="absolute left-0 top-full z-50 mt-3 min-w-[16rem] border border-woodsmoke-800 bg-woodsmoke py-2 shadow-lg"
									data-nav-dropdown-panel
									hidden
								>
									{item.children.map((child) => (
										<li>
											<a href={child.href} class={dropdownLinkClass}>
												{child.label}
											</a>
										</li>
									))}
								</ul>
							</li>
						) : (
							<li>
								<a href={item.href} class={linkClass}>
									{item.label}
								</a>
							</li>
						),
					)
				}
			</ul>

			<div
				class="hidden items-center gap-2 text-[0.9375rem] font-medium tracking-wide lg:flex"
				aria-label={langLabel}
			>
				<a
					href={huHref}
					hreflang="hu"
					class:list={[
						'transition-colors hover:text-azure-300',
						locale === 'hu' && 'underline underline-offset-4',
					]}
					aria-current={locale === 'hu' ? 'true' : undefined}
				>
					HU
				</a>
				<span class="text-woodsmoke-400" aria-hidden="true">/</span>
				<a
					href={enHref}
					hreflang="en"
					class:list={[
						'transition-colors hover:text-azure-300',
						locale === 'en' && 'underline underline-offset-4',
					]}
					aria-current={locale === 'en' ? 'true' : undefined}
				>
					EN
				</a>
			</div>

			<button
				type="button"
				class="inline-flex h-10 w-10 cursor-pointer items-center justify-center lg:hidden"
				data-nav-toggle
				data-label-open={ui.menuOpen}
				data-label-close={ui.menuClose}
				aria-expanded="false"
				aria-controls="mobile-nav-panel"
				aria-label={ui.menuOpen}
			>
				<svg
					class="h-5 w-5"
					data-nav-icon="menu"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg
					class="hidden h-5 w-5"
					data-nav-icon="close"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div
		id="mobile-nav-panel"
		class="absolute inset-x-0 top-full border-t border-woodsmoke-800 bg-woodsmoke px-6 pb-6 pt-4 lg:hidden"
		data-nav-panel
		hidden
	>
		<ul class="flex flex-col gap-1">
			{
				items.map((item) =>
					item.children?.length ? (
						<li data-nav-dropdown>
							<button
								type="button"
								class:list={[
									linkClass,
									'flex w-full items-center justify-between gap-3 py-2 text-left',
								]}
								data-nav-dropdown-toggle
								data-label-open={ui.submenuOpen}
								data-label-close={ui.submenuClose}
								aria-expanded="false"
								aria-controls={`mobile-nav-dropdown-${item.href.slice(1)}`}
								aria-label={`${item.label}: ${ui.submenuOpen}`}
							>
								<span aria-hidden="true">{item.label}</span>
								<svg
									class="h-3.5 w-3.5 shrink-0 transition-transform duration-200"
									data-nav-dropdown-chevron
									viewBox="0 0 16 16"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									aria-hidden="true"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M4 6l4 4 4-4" />
								</svg>
							</button>
							<ul
								id={`mobile-nav-dropdown-${item.href.slice(1)}`}
								class="mb-2 ml-3 flex flex-col gap-1 border-l border-woodsmoke-800 pl-4"
								data-nav-dropdown-panel
								hidden
							>
								{item.children.map((child) => (
									<li>
										<a
											href={child.href}
											class="block cursor-pointer py-2 font-sans text-[0.875rem] font-medium text-woodsmoke-200 transition-colors hover:text-azure-300"
										>
											{child.label}
										</a>
									</li>
								))}
							</ul>
						</li>
					) : (
						<li>
							<a href={item.href} class:list={[linkClass, 'block py-2']}>
								{item.label}
							</a>
						</li>
					),
				)
			}
		</ul>
		<div
			class="mt-6 flex items-center gap-2 text-[0.9375rem] font-medium tracking-wide"
			aria-label={langLabel}
		>
			<a
				href={huHref}
				hreflang="hu"
				class:list={[
					'transition-colors hover:text-azure-300',
					locale === 'hu' && 'underline underline-offset-4',
				]}
				aria-current={locale === 'hu' ? 'true' : undefined}
			>
				HU
			</a>
			<span class="text-woodsmoke-400" aria-hidden="true">/</span>
			<a
				href={enHref}
				hreflang="en"
				class:list={[
					'transition-colors hover:text-azure-300',
					locale === 'en' && 'underline underline-offset-4',
				]}
				aria-current={locale === 'en' ? 'true' : undefined}
			>
				EN
			</a>
		</div>
	</div>
</header>

<script>
	import { initNavigation } from '../scripts/navigation';

	document.querySelectorAll<HTMLElement>('[data-navigation]').forEach((root) => {
		initNavigation(root);
	});
</script>
