---
import { urlFor } from '../lib/sanity/image';
import type { LogoItem } from '../lib/sanity/clientLogos';

interface Props {
	logos: LogoItem[];
	align?: 'center' | 'start';
}

const { logos, align = 'center' } = Astro.props;

const listClass =
	align === 'center'
		? 'flex flex-wrap items-center justify-center gap-x-5 gap-y-5 sm:gap-x-8 sm:gap-y-6 lg:gap-x-14 lg:gap-y-10'
		: 'flex flex-wrap items-center gap-x-5 gap-y-5 sm:gap-x-8 sm:gap-y-6 lg:gap-x-14 lg:gap-y-10';
---

<ul class={listClass}>
	{
		logos.map((logo) => (
			<li class="flex h-16 w-36 items-center justify-center lg:h-20 lg:w-44" data-stagger-item>
				<img
					class="max-h-full max-w-full object-contain"
					src={urlFor({ asset: { _ref: logo.asset!._id } })
						.height(80)
						.fit('max')
						.auto('format')
						.url()}
					alt={logo.alt ?? ''}
					loading="lazy"
					decoding="async"
				/>
			</li>
		))
	}
</ul>
