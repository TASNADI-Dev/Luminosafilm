---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getClientLogos } from '../../lib/sanity/clientLogos';

const logos = await getClientLogos('en');
---

<BaseLayout locale="en" title="Contact | Luminosa Film">
	<section class="relative overflow-hidden pt-6 lg:pt-[10rem]">
		<div class="mx-auto grid max-w-container gap-10 px-6 lg:grid-cols-2 lg:items-start lg:gap-16 lg:px-10">
			<div class="order-1 flex flex-col gap-8">
				<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
					Contact
				</h1>
				{
					logos && (
						<div class="hidden lg:block">
							<ClientLogos logos={logos} align="start" />
						</div>
					)
				}
			</div>
			<div class="order-2">
				<ContactForm locale="en" />
			</div>
			{
				logos && (
					<div class="order-3 lg:hidden">
						<ClientLogos logos={logos} align="start" />
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>
