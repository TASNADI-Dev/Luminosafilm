---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceStatsSection from '../../components/ExperienceStatsSection.astro';
import { getAboutPage } from '../../lib/sanity/aboutPage';

const { hero, image, closingParagraph, experienceStats } = await getAboutPage('en');
---

<BaseLayout locale="en" title={`${hero.heading} | Luminosa Film`}>
	<section class="relative overflow-hidden pt-6 lg:pt-[10rem]">
		<div class="mx-auto flex max-w-container flex-col items-center gap-6 px-6 text-center lg:px-10">
			<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
				{hero.heading}
			</h1>
			<p class="max-w-xl text-[1.125rem] leading-relaxed text-woodsmoke-50">
				{hero.paragraph}
			</p>
		</div>
	</section>

	{
		image && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto max-w-container px-6 lg:px-10">
					<img
						class="aspect-video w-full object-cover"
						src={image.url}
						alt={image.alt || ''}
						width={1440}
						height={810}
						loading="lazy"
					/>
				</div>
			</section>
		)
	}

	{
		closingParagraph && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto max-w-container px-6 text-center lg:px-10">
					<p class="mx-auto max-w-2xl text-[1.125rem] leading-relaxed text-woodsmoke-50">
						{closingParagraph}
					</p>
				</div>
			</section>
		)
	}

	{experienceStats && <ExperienceStatsSection items={experienceStats} />}
</BaseLayout>
