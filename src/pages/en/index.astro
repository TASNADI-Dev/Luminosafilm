---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import GlobalCtaSection from '../../components/GlobalCtaSection.astro';
import ServicesOverviewBlock from '../../components/ServicesOverviewBlock.astro';
import WhyChooseUsItem from '../../components/WhyChooseUsItem.astro';
import { asset } from '../../lib/assets';
import {
	globalCtaSectionButtonHref,
	heroButtonHref,
	heroVideoToggleLabels,
	homeHighlightedReferencesButton,
	homeReferencesHeading,
	servicesOverviewButtonLabel,
} from '../../lib/i18n';
import { getClientLogos } from '../../lib/sanity/clientLogos';
import { getGlobalCtaSection } from '../../lib/sanity/globalCtaSection';
import {
	getHomePageHero,
	getHomePageHighlightedReferences,
	getHomePageServicesOverview,
	getHomePageWhyChooseUs,
} from '../../lib/sanity/homePage';

const hero = await getHomePageHero('en');
const logos = await getClientLogos('en');
const servicesOverview = await getHomePageServicesOverview('en');
const whyChooseUs = await getHomePageWhyChooseUs('en');
const highlightedReferences = await getHomePageHighlightedReferences('en');
const cta = await getGlobalCtaSection('en');
const heroVideoSrc = asset('/home/Showreel.mp4');
const ctaButtonHref = globalCtaSectionButtonHref.en;
const servicesOverviewCtaLabel = servicesOverviewButtonLabel.en;
const highlightedReferencesHeading = homeReferencesHeading.en;
const highlightedReferencesCta = homeHighlightedReferencesButton.en;
const heroVideoToggle = heroVideoToggleLabels.en;
---

<BaseLayout locale="en">
	<section class="relative isolate overflow-hidden pt-6 lg:pt-[20rem]" data-hero-section>
		<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
			<video
				class="h-full w-full scale-110 object-cover blur-[5rem]"
				src={heroVideoSrc}
				autoplay
				muted
				playsinline
				loop
				preload="auto"
				tabindex="-1"
				data-hero-video-bg
			>
			</video>
			<div class="absolute inset-0 bg-woodsmoke-950/50"></div>
		</div>

		<div
			class="relative z-10 mx-auto grid max-w-container items-end gap-10 px-6 pb-16 lg:grid-cols-2 lg:gap-16 lg:px-10 lg:pb-24"
		>
			<div class="order-2 flex flex-col gap-6 lg:order-1">
				<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
					{hero.heading}
				</h1>
				<p class="max-w-xl text-[1.125rem] leading-relaxed text-woodsmoke-50">
					{hero.paragraph}
				</p>
				<div>
					<Button href={heroButtonHref.en}>{hero.buttonText}</Button>
				</div>
			</div>

			<div class="relative order-1 lg:order-2">
				<video
					class="aspect-video w-full bg-woodsmoke-900 object-cover"
					src={heroVideoSrc}
					autoplay
					muted
					playsinline
					loop
					preload="auto"
					disablepictureinpicture
					data-hero-video-main
				>
				</video>
				<button
					type="button"
					class="absolute bottom-4 left-4 flex size-12 items-center justify-center rounded-full bg-woodsmoke-50 text-bunting-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-woodsmoke-50"
					data-hero-video-toggle
					data-label-play={heroVideoToggle.play}
					data-label-pause={heroVideoToggle.pause}
					aria-label={heroVideoToggle.pause}
				>
					<svg
						data-hero-video-icon="play"
						class="hidden h-5 w-5 fill-current"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M8 5v14l11-7z"></path>
					</svg>
					<svg
						data-hero-video-icon="pause"
						class="h-5 w-5 fill-current"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"></path>
					</svg>
				</button>
			</div>
		</div>
	</section>

	{
		logos && (
			<section class="py-12 lg:py-16">
				<div class="mx-auto max-w-container px-6 lg:px-10">
					<ClientLogos logos={logos} />
				</div>
			</section>
		)
	}

	<section id="services" class="py-16 lg:py-24">
		<div class="mx-auto max-w-container px-6 lg:px-10">
			<div class="mb-10 lg:mb-14">
				<h2 class="font-heading max-w-3xl text-[2.5rem] leading-[1.15] tracking-tight lg:text-[3rem]">
					{whyChooseUs.heading}
				</h2>
			</div>

			<ol class="list-none divide-y divide-woodsmoke-900 border-b border-woodsmoke-900 p-0">
				{
					whyChooseUs.items.map((item, index) => (
						<WhyChooseUsItem
							index={index}
							title={item.title}
							body={item.body}
							imageUrl={item.imageUrl}
							imageAlt={item.imageAlt}
						/>
					))
				}
			</ol>

			<div class="mt-8 flex flex-wrap items-center gap-3 lg:mt-10">
				<Button href={heroButtonHref.en}>{hero.buttonText}</Button>
			</div>
		</div>
	</section>

	<section class="py-16 lg:py-24">
		<div class="mx-auto max-w-container px-6 lg:px-10">
			<ul class="flex list-none flex-col gap-16 p-0 lg:gap-24">
				{
					servicesOverview.blocks.map((block, index) => (
						<ServicesOverviewBlock
							index={index}
							heading={block.heading}
							paragraph={block.paragraph}
							href={block.href}
							buttonLabel={servicesOverviewCtaLabel}
							imageUrl={block.imageUrl}
							imageAlt={block.imageAlt}
						/>
					))
				}
			</ul>
		</div>
	</section>

	{
		highlightedReferences && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto flex max-w-container flex-col gap-8 px-6 lg:gap-10 lg:px-10">
					<h2 class="text-left font-heading text-[2.5rem] leading-[1.15] tracking-tight lg:text-[3rem]">
						{highlightedReferencesHeading}
					</h2>
					<ul
						class:list={[
							'flex list-none flex-col gap-8 p-0 lg:gap-8',
							highlightedReferences.items.length >= 2
								? 'lg:flex-row'
								: 'lg:max-w-[calc((100%-2rem)/2)]',
						]}
					>
						{highlightedReferences.items.map((reference) => (
							<li class="flex min-w-0 flex-1 flex-col gap-4">
								<iframe
									class="aspect-video w-full bg-woodsmoke-900"
									src={`https://www.youtube-nocookie.com/embed/${reference.youtubeId}`}
									title={reference.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								/>
								<h3 class="font-heading text-[1.25rem] leading-snug tracking-tight lg:text-[1.5rem]">
									{reference.title}
								</h3>
							</li>
						))}
					</ul>
					<div class="flex justify-center">
						<Button href={highlightedReferencesCta.href} variant="secondary">
							{highlightedReferencesCta.label}
						</Button>
					</div>
				</div>
			</section>
		)
	}

	<GlobalCtaSection
		heading={cta.heading}
		paragraph={cta.paragraph}
		buttonText={cta.buttonText}
		buttonHref={ctaButtonHref}
	/>

	<script>
		import { initHeroVideoSync } from '../../scripts/hero-video-sync';

		document.querySelectorAll<HTMLElement>('[data-hero-section]').forEach((section) => {
			initHeroVideoSync(section);
		});
	</script>
</BaseLayout>
