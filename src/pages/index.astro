---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ServicesOverviewBlock from '../components/ServicesOverviewBlock.astro';
import WhyChooseUsItem from '../components/WhyChooseUsItem.astro';
import { asset } from '../lib/assets';
import { heroButtonHref, servicesOverviewButtonLabel, whyChooseUsButton } from '../lib/i18n';
import {
	getHomePageHero,
	getHomePageLogos,
	getHomePageServicesOverview,
	getHomePageWhyChooseUs,
} from '../lib/sanity/homePage';
import { urlFor } from '../lib/sanity/image';

const hero = await getHomePageHero('hu');
const logosSection = await getHomePageLogos('hu');
const servicesOverview = await getHomePageServicesOverview('hu');
const whyChooseUs = await getHomePageWhyChooseUs('hu');
const heroVideoSrc = asset('/home/Showreel.mp4');
const whyChooseUsCta = whyChooseUsButton.hu;
const servicesOverviewCtaLabel = servicesOverviewButtonLabel.hu;
---

<BaseLayout locale="hu">
	<section class="relative isolate overflow-hidden pt-6 lg:pt-[20rem]" data-hero-section>
		<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
			<video
				class="h-full w-full scale-110 object-cover blur-[5rem]"
				src={heroVideoSrc}
				autoplay
				muted
				playsinline
				loop
				preload="auto"
				tabindex="-1"
				data-hero-video-bg
			>
			</video>
			<div class="absolute inset-0 bg-woodsmoke-950/50"></div>
		</div>

		<div
			class="relative z-10 mx-auto grid max-w-container items-end gap-10 px-6 pb-16 lg:grid-cols-2 lg:gap-16 lg:px-10 lg:pb-24"
		>
			<div class="order-2 flex flex-col gap-6 lg:order-1">
				<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
					{hero.heading}
				</h1>
				<p class="max-w-xl text-[1.125rem] leading-relaxed text-woodsmoke-50">
					{hero.paragraph}
				</p>
				<div>
					<Button href={heroButtonHref.hu}>{hero.buttonText}</Button>
				</div>
			</div>

			<div class="order-1 lg:order-2">
				<video
					class="aspect-video w-full bg-woodsmoke-900 object-cover"
					src={heroVideoSrc}
					autoplay
					muted
					playsinline
					loop
					preload="auto"
					controls
					controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
					disablepictureinpicture
					data-hero-video-main
				>
				</video>
			</div>
		</div>
	</section>

	{
		logosSection && (
			<section class="py-12 lg:py-16">
				<div class="mx-auto max-w-container px-6 lg:px-10">
					<ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8 lg:gap-x-14 lg:gap-y-10">
						{logosSection.logos.map((logo) => (
							<li class="flex h-16 w-36 items-center justify-center lg:h-20 lg:w-44">
								<img
									class="max-h-full max-w-full object-contain"
									src={urlFor({ asset: { _ref: logo.asset!._id } })
										.height(80)
										.fit('max')
										.auto('format')
										.url()}
									alt={logo.alt ?? ''}
									loading="lazy"
									decoding="async"
								/>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section id="szolgaltatasok" class="py-16 lg:py-24">
		<div class="mx-auto max-w-container px-6 lg:px-10">
			<div class="mb-10 lg:mb-14">
				<h2 class="font-heading max-w-3xl text-[2.5rem] leading-[1.15] tracking-tight lg:text-[3rem]">
					{whyChooseUs.heading}
				</h2>
			</div>

			<ol class="list-none divide-y divide-woodsmoke-900 border-b border-woodsmoke-900 p-0">
				{
					whyChooseUs.items.map((item, index) => (
						<WhyChooseUsItem
							index={index}
							title={item.title}
							body={item.body}
							imageUrl={item.imageUrl}
							imageAlt={item.imageAlt}
						/>
					))
				}
			</ol>

			<div class="mt-8 flex flex-wrap items-center gap-3 lg:mt-10">
				<Button href={whyChooseUsCta.href}>{whyChooseUsCta.label}</Button>
			</div>
		</div>
	</section>

	<section class="py-16 lg:py-24">
		<div class="mx-auto max-w-container px-6 lg:px-10">
			<ul class="flex list-none flex-col gap-16 p-0 lg:gap-24">
				{
					servicesOverview.blocks.map((block, index) => (
						<ServicesOverviewBlock
							index={index}
							heading={block.heading}
							paragraph={block.paragraph}
							href={block.href}
							buttonLabel={servicesOverviewCtaLabel}
							imageUrl={block.imageUrl}
							imageAlt={block.imageAlt}
						/>
					))
				}
			</ul>
		</div>
	</section>

	<script>
		import { initHeroVideoSync } from '../scripts/hero-video-sync';

		document.querySelectorAll<HTMLElement>('[data-hero-section]').forEach((section) => {
			initHeroVideoSync(section);
		});
	</script>
</BaseLayout>
