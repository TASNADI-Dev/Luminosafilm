---
import BaseLayout from '../layouts/BaseLayout.astro';
import AchievementsSection from '../components/AchievementsSection.astro';
import ExperienceStatsSection from '../components/ExperienceStatsSection.astro';
import GlobalCtaSection from '../components/GlobalCtaSection.astro';
import { globalCtaSectionButtonHref, recognitionsHeading } from '../lib/i18n';
import { getAboutPage } from '../lib/sanity/aboutPage';
import { getGlobalCtaSection } from '../lib/sanity/globalCtaSection';

const { hero, image, closingParagraph, experienceStats, achievements } = await getAboutPage('hu');
const cta = await getGlobalCtaSection('hu');
const ctaButtonHref = globalCtaSectionButtonHref.hu;
---

<BaseLayout locale="hu" title={`${hero.heading} | Luminosa Film`}>
	<section class="relative overflow-hidden pt-6 pb-16 lg:pt-[10rem] lg:pb-24">
		<div class="mx-auto flex max-w-container flex-col items-center px-6 text-center lg:px-10">
			<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
				{hero.heading}
			</h1>
			<p class="mt-6 max-w-xl text-[1.125rem] leading-relaxed text-woodsmoke-50">
				{hero.paragraph}
			</p>
			{
				image && (
					<img
						class="mt-16 aspect-video w-full object-cover lg:mt-24"
						src={image.url}
						alt={image.alt || ''}
						width={1440}
						height={810}
					/>
				)
			}
		</div>
	</section>

	{
		closingParagraph && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto max-w-container px-6 text-center lg:px-10">
					<p class="mx-auto max-w-2xl text-[1.125rem] leading-relaxed text-woodsmoke-50">
						{closingParagraph}
					</p>
				</div>
			</section>
		)
	}

	{experienceStats && <ExperienceStatsSection items={experienceStats} />}

	{
		achievements && (
			<AchievementsSection heading={recognitionsHeading.hu} items={achievements} />
		)
	}

	<GlobalCtaSection
		heading={cta.heading}
		paragraph={cta.paragraph}
		buttonText={cta.buttonText}
		buttonHref={ctaButtonHref}
	/>
</BaseLayout>
