---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ContactForm from '../components/ContactForm.astro';
import { getClientLogos } from '../lib/sanity/clientLogos';

const logos = await getClientLogos('hu');
---

<BaseLayout locale="hu" title="Kapcsolat | Luminosa Film">
	<section class="relative overflow-hidden pt-6 lg:pt-[10rem]">
		<div class="mx-auto grid max-w-container gap-10 px-6 lg:grid-cols-2 lg:items-start lg:gap-16 lg:px-10">
			<div class="flex flex-col gap-8">
				<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
					Kapcsolat
				</h1>
				{logos && <ClientLogos logos={logos} align="start" />}
			</div>
			<ContactForm locale="hu" />
		</div>
	</section>
</BaseLayout>
