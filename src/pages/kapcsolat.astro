---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ContactForm from '../components/ContactForm.astro';
import { getClientLogos } from '../lib/sanity/clientLogos';

const logos = await getClientLogos('hu');
---

<BaseLayout locale="hu" title="Kapcsolat | Luminosa Film">
	<section class="relative overflow-hidden pt-6 pb-16 lg:pt-[10rem] lg:pb-24" data-hero-section>
		<div class="mx-auto grid max-w-container gap-10 px-6 lg:grid-cols-2 lg:items-start lg:gap-16 lg:px-10">
			<div class="order-1 flex flex-col gap-8" data-hero-copy-item>
				<h1 class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]">
					Kapcsolat
				</h1>
				{
					logos && (
						<div class="hidden lg:block">
							<ClientLogos logos={logos} align="start" />
						</div>
					)
				}
			</div>
			<div class="order-2" data-hero-copy-item>
				<ContactForm locale="hu" />
			</div>
			{
				logos && (
					<div class="order-3 lg:hidden">
						<ClientLogos logos={logos} align="start" />
					</div>
				)
			}
		</div>
	</section>

	<script>
		import { initHomeIntro } from '../scripts/home-intro';

		initHomeIntro();
	</script>
</BaseLayout>
