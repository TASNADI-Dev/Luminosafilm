---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlobalCtaSection from '../../components/GlobalCtaSection.astro';
import PortableText from '../../components/PortableText.astro';
import ServiceHeroMarquee from '../../components/ServiceHeroMarquee.astro';
import {
	globalCtaSectionButtonHref,
	localeHomePath,
	serviceRelatedReferencesHeading,
} from '../../lib/i18n';
import { getGlobalCtaSection } from '../../lib/sanity/globalCtaSection';
import { getPrimaryButtonText } from '../../lib/sanity/primaryButton';
import { getServicePageBySlug, getServicePageSlugs } from '../../lib/sanity/servicePage';

export async function getStaticPaths() {
	const slugs = await getServicePageSlugs('hu');
	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect(localeHomePath('hu'));
}

const page = await getServicePageBySlug('hu', slug);
if (!page) {
	return Astro.redirect(localeHomePath('hu'));
}

const [cta, primaryButtonText] = await Promise.all([
	getGlobalCtaSection('hu'),
	getPrimaryButtonText('hu'),
]);
const { hero, featureRows, relatedReferences } = page;
const relatedReferencesHeading = serviceRelatedReferencesHeading.hu;
const ctaButtonHref = globalCtaSectionButtonHref.hu;
---

<BaseLayout locale="hu" title={`${page.title} | Luminosa Film`}>
	<section class="overflow-hidden pt-16 lg:pt-[10rem]" data-hero-section>
		<div class="mx-auto flex max-w-container flex-col items-center gap-6 px-6 text-center lg:px-10">
			<h1
				class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]"
				data-hero-copy-item
			>
				{hero.heading}
			</h1>
			<p
				class="max-w-xl text-[1.125rem] leading-relaxed text-woodsmoke-50"
				data-hero-copy-item
			>
				{hero.paragraph}
			</p>
		</div>

		<ServiceHeroMarquee images={hero.images} label={hero.heading} />
	</section>

	{
		featureRows && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto grid max-w-container grid-cols-1 gap-10 px-6 lg:grid-cols-12 lg:gap-8 lg:px-10">
					<div class="lg:col-span-5">
						<h2 class="font-heading text-[2.5rem] leading-[1.15] tracking-tight lg:sticky lg:top-[6rem] lg:text-[3rem]">
							{featureRows.heading}
						</h2>
					</div>
					<div class="lg:col-span-7">
						<PortableText value={featureRows.paragraph} />
					</div>
				</div>
			</section>
		)
	}

	{
		relatedReferences && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto flex max-w-container flex-col gap-8 px-6 lg:gap-10 lg:px-10">
					<h2 class="text-left font-heading text-[2.5rem] leading-[1.15] tracking-tight lg:text-[3rem]">
						{relatedReferencesHeading}
					</h2>
					<ul
						class:list={[
							'flex list-none flex-col gap-8 p-0 lg:gap-8',
							relatedReferences.length >= 2
								? 'lg:flex-row'
								: 'lg:max-w-[calc((100%-2rem)/2)]',
						]}
					>
						{relatedReferences.map((reference) => (
							<li class="flex min-w-0 flex-1 flex-col gap-4">
								<iframe
									class="aspect-video w-full bg-woodsmoke-900"
									src={`https://www.youtube-nocookie.com/embed/${reference.youtubeId}`}
									title={reference.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								/>
								<h3 class="font-heading text-[1.25rem] leading-snug tracking-tight lg:text-[1.5rem]">
									{reference.title}
								</h3>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<GlobalCtaSection
		heading={cta.heading}
		paragraph={cta.paragraph}
		buttonText={primaryButtonText}
		buttonHref={ctaButtonHref}
	/>

	<script>
		import { initHomeIntro } from '../../scripts/home-intro';
		import { initServiceHeroMarquee } from '../../scripts/service-hero-marquee';

		initServiceHeroMarquee();
		initHomeIntro();
	</script>
</BaseLayout>
