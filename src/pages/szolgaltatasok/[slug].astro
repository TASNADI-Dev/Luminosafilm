---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import GlobalCtaSection from '../../components/GlobalCtaSection.astro';
import {
	globalCtaSectionButtonHref,
	localeHomePath,
	serviceRelatedReferencesHeading,
	serviceWhyChooseUsButtonHref,
} from '../../lib/i18n';
import { getGlobalCtaSection } from '../../lib/sanity/globalCtaSection';
import { getServicePageBySlug, getServicePageSlugs } from '../../lib/sanity/servicePage';

export async function getStaticPaths() {
	const slugs = await getServicePageSlugs('hu');
	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect(localeHomePath('hu'));
}

const page = await getServicePageBySlug('hu', slug);
if (!page) {
	return Astro.redirect(localeHomePath('hu'));
}

const cta = await getGlobalCtaSection('hu');
const { hero, featureRows, whyChooseUs, relatedReferences } = page;
const marqueeImages = hero.images.length > 0 ? [...hero.images, ...hero.images] : [];
const whyChooseUsButtonHref = serviceWhyChooseUsButtonHref.hu;
const relatedReferencesHeading = serviceRelatedReferencesHeading.hu;
const ctaButtonHref = globalCtaSectionButtonHref.hu;
---

<BaseLayout locale="hu" title={`${page.title} | Luminosa Film`}>
	<section class="relative overflow-hidden pt-6 lg:pt-[10rem]" data-hero-section>
		<div class="mx-auto flex max-w-container flex-col items-center gap-6 px-6 text-center lg:px-10">
			<h1
				class="font-heading text-[3rem] leading-[1.1] tracking-tight lg:text-[4rem]"
				data-hero-copy-item
			>
				{hero.heading}
			</h1>
			<p
				class="max-w-xl text-[1.125rem] leading-relaxed text-woodsmoke-50"
				data-hero-copy-item
			>
				{hero.paragraph}
			</p>
		</div>

		{
			marqueeImages.length > 0 && (
				<div class="relative mt-16 overflow-hidden lg:mt-24" data-hero-copy-item>
					<ul
						class="service-hero-marquee-track flex w-max"
						aria-label={hero.heading}
					>
						{marqueeImages.map((image, index) => {
							const isDuplicate = index >= hero.images.length;
							return (
								<li
									class="mr-[0.5rem] h-[10.6875rem] w-[14.625rem] shrink-0"
									aria-hidden={isDuplicate ? 'true' : undefined}
								>
									<img
										class="h-full w-full object-cover"
										src={image.url}
										alt={isDuplicate ? '' : image.alt || ''}
										width={234}
										height={171}
										loading={index < 4 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</li>
							);
						})}
					</ul>
					<div
						class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-bunting-950/90 to-transparent"
						aria-hidden="true"
					/>
				</div>
			)
		}
	</section>

	{
		featureRows && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto grid max-w-container grid-cols-1 gap-10 px-6 lg:grid-cols-12 lg:gap-8 lg:px-10">
					<div class="lg:col-span-5">
						<h2 class="font-heading text-[2.5rem] leading-[1.15] tracking-tight lg:sticky lg:top-[6rem] lg:text-[3rem]">
							{featureRows.heading}
						</h2>
					</div>
					<ul class="flex list-none flex-col gap-10 p-0 lg:col-span-7 lg:gap-12">
						{featureRows.rows.map((row) => (
							<li class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8" data-stagger>
								{row.imageUrl ? (
									<img
										class="h-[10.6875rem] w-[14.625rem] shrink-0 object-cover"
										src={row.imageUrl}
										alt={row.imageAlt || ''}
										width={234}
										height={171}
										loading="lazy"
										decoding="async"
									/>
								) : (
									<div
										class="h-[10.6875rem] w-[14.625rem] shrink-0 bg-woodsmoke-800"
										aria-hidden="true"
									/>
								)}
								<div class="flex min-w-0 flex-col gap-3">
									<h3 class="font-heading text-[1.25rem] leading-snug tracking-tight lg:text-[1.5rem]">
										{row.title}
									</h3>
									<p class="text-[0.9375rem] leading-relaxed text-woodsmoke-300">
										{row.body}
									</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		whyChooseUs && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto grid max-w-container grid-cols-1 gap-10 px-6 lg:grid-cols-12 lg:items-stretch lg:gap-12 lg:px-10">
					<div class="lg:col-span-5">
						{whyChooseUs.imageUrl ? (
							<img
								class="aspect-video w-full object-cover lg:aspect-auto lg:h-full"
								src={whyChooseUs.imageUrl}
								alt={whyChooseUs.imageAlt || ''}
								width={480}
								height={270}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div
								class="aspect-video w-full bg-woodsmoke-800 lg:aspect-auto lg:h-full"
								aria-hidden="true"
							/>
						)}
					</div>
					<div class="flex min-w-0 flex-col gap-6 lg:col-span-7 lg:gap-8">
						<div class="flex flex-col gap-4">
							<h2 class="font-heading text-[2.5rem] leading-[1.15] tracking-tight lg:text-[3rem]">
								{whyChooseUs.heading}
							</h2>
							<p class="text-[1.125rem] leading-relaxed text-woodsmoke-50">
								{whyChooseUs.paragraph}
							</p>
						</div>
						<div class="rounded-[0.5rem] bg-gradient-to-br from-bunting-400/60 via-bunting-600/40 to-bunting-950 p-px">
							<ul class="flex list-none flex-col gap-6 rounded-[calc(0.5rem-1px)] bg-bunting-950/90 p-6 lg:gap-8 lg:p-8">
								{whyChooseUs.rows.map((row) => (
									<li class="flex flex-col gap-2">
										<h3 class="font-heading text-[1.25rem] leading-snug tracking-tight lg:text-[1.5rem]">
											{row.title}
										</h3>
										<p class="text-[0.9375rem] leading-relaxed text-woodsmoke-300">
											{row.body}
										</p>
									</li>
								))}
							</ul>
						</div>
						<div>
							<Button href={whyChooseUsButtonHref}>{whyChooseUs.buttonText}</Button>
						</div>
					</div>
				</div>
			</section>
		)
	}

	{
		relatedReferences && (
			<section class="py-16 lg:py-24">
				<div class="mx-auto flex max-w-container flex-col gap-8 px-6 lg:gap-10 lg:px-10">
					<h2 class="text-left font-heading text-[2.5rem] leading-[1.15] tracking-tight lg:text-[3rem]">
						{relatedReferencesHeading}
					</h2>
					<ul
						class:list={[
							'flex list-none flex-col gap-8 p-0 lg:gap-8',
							relatedReferences.length >= 2
								? 'lg:flex-row'
								: 'lg:max-w-[calc((100%-2rem)/2)]',
						]}
					>
						{relatedReferences.map((reference) => (
							<li class="flex min-w-0 flex-1 flex-col gap-4">
								<iframe
									class="aspect-video w-full bg-woodsmoke-900"
									src={`https://www.youtube-nocookie.com/embed/${reference.youtubeId}`}
									title={reference.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								/>
								<h3 class="font-heading text-[1.25rem] leading-snug tracking-tight lg:text-[1.5rem]">
									{reference.title}
								</h3>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<GlobalCtaSection
		heading={cta.heading}
		paragraph={cta.paragraph}
		buttonText={cta.buttonText}
		buttonHref={ctaButtonHref}
	/>

	<script>
		import { initHomeIntro } from '../../scripts/home-intro';

		initHomeIntro();
	</script>
</BaseLayout>
